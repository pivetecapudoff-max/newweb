# Copy to .env. Without these, Illusions stays local (account.json only).

# Public URL of the hosted site (https://your-domain.com). Needed for Discord redirect + cookies.
APP_PUBLIC_URL=http://127.0.0.1:5174
# Hosts like Railway/Render set PORT. That also binds 0.0.0.0.
# FAROL_HOST=0.0.0.0

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Discord redirect: {APP_PUBLIC_URL}/api/auth/discord/callback

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# At least 16 random characters. Used to sign the login cookie and encrypt Roblox cookies.
SESSION_SECRET=
# Optional separate encryption key. If empty, SESSION_SECRET is used.
COOKIE_ENCRYPT_KEY=
